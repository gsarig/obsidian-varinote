{
	"name": "varinote",
	"version": "1.1.3",
	"description": "Add variables in Templates and set their values on-the-fly during the Note creation.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"lint": "eslint src",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.4",
		"@wdio/cli": "^9.29.1",
		"@wdio/globals": "^9.29.1",
		"@wdio/local-runner": "^9.29.1",
		"@wdio/mocha-framework": "^9.29.1",
		"esbuild": "0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jiti": "^2.7.0",
		"mocha": "^10.8.2",
		"moment": "2.29.4",
		"obsidian": "1.7.2",
		"obsidian-launcher": "^3.1.1",
		"tslib": "2.8.1",
		"tsx": "^4.23.1",
		"typescript": "5.7.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^3.0.0",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	},
	"overrides": {
		"serialize-javascript": "^7.0.7"
	}
}
